#!/bin/bash
# check-wording <dir> — the zero-model copy fence (plan §2). Every text node of each served page must be in that page's ALLOWLIST
# (its language's card file + sheet file + the TR-labels labels + the forty references + the forty texts + the translation names)
# after the ONE normalisation (normalise.mjs); the card block == its card file; the forty refs == the pool; zero <script src>, <img>,
# cookie words, external requests; the share hrefs URL-decoded == the h1 line + the address. rc 1 on anything else. Usage: bash check-wording docs/
cd "$(dirname "$0")" || exit 1; export CW_DIR="${1:-docs}" CW_ROOT="$PWD"
exec node --input-type=module - <<'JS'
import fs from 'node:fs'; import path from 'node:path';
const root = process.env.CW_ROOT, dir = path.resolve(process.env.CW_DIR), { normalise } = await import(path.join(root, 'normalise.mjs'));
const J = p => JSON.parse(fs.readFileSync(p, 'utf8')), C = p => path.join(root, 'content', p);
const sheet = J(C('sheet.json')), verses = J(C('verses.json')), tr = J(C('translations.json')), ADDRESS = 'https://3r4l.org/';
// THE ONE LEGAL STRING beside the owner's and Jeff's words (TR-translation; owner word 2026-10-07 "use NIV translation"): Biblica's gratis-use notice,
// printed once at the foot of each page by build.mjs from translations.json — the record there and this fence must agree, byte for byte.
let NOTICE = ''; // THE ONE LEGAL STRING beside the owner's and brother Daniel's words: the default English translation's OWN notice from translations.json (NIV: Biblica's line; KJV: none — public domain; owner word 2026-10-08 "Let all scripture on site be taken from kjv")
const enDefault = Object.values(tr.en).find(t => t.default); NOTICE = enDefault ? (enDefault.notice || '') : ''; if (!enDefault) { console.log('FAIL: the default English translation\'s notice in translations.json is not the legal string of record'); process.exit(1); }
const inputs = '/Users/aibrain/projects/3r4l-inputs', checked = fs.existsSync(C('sheet-tl.json')) && fs.existsSync(path.join(inputs, 'pastor-check.txt'));
const cardOf = f => fs.existsSync(f) ? fs.readFileSync(f, 'utf8') : null, cardEn = cardOf(C('card.txt')), cardTl = cardOf(path.join(inputs, 'card-tl.txt'));
const blocks = t => t ? [...t.matchAll(/^== \w+ ==\n([\s\S]*?)(?=\n== \w+ ==\n|(?![\s\S]))/gm)].map(m => m[1].replace(/\n$/, '')) : []; // a block ends at the next header or EOF, never at a line end (the plan's `$` under the m flag cut each block to its first line; defect met 2026-10-07)
function allow(lang) { const S = lang === 'tl' ? J(C('sheet-tl.json')) : sheet, card = lang === 'tl' ? (cardTl || cardEn) : cardEn, A = new Set(), add = s => { if (s) A.add(normalise(s)); };
  [S.h1, S.h2, S.whatnext_link, S.whatnext_clause, ...S.h1_lines, ...S.lines].forEach(add); Object.entries(S.labels).forEach(([k, v]) => { if (k[0] !== '_') { add(v); add(v + ' ›'); } });
  const title = card ? blocks(card)[0] : '3R4L'; add(title); add(title + S.labels.title_whatnext_suffix); add(ADDRESS); add(NOTICE); // the legal string, both languages
  if (card) blocks(card).forEach(b => { add(b); b.split('\n').forEach(add); }); else add(sheet.placeholder.card); // THE INTERIM: the one placeholder sentence is allowed
  verses.forEach(v => { add(lang === 'tl' ? v.ref_tl : v.ref); add(lang === 'tl' ? v.text_tl : v.text); add(lang === 'tl' ? v.translation_tl : v.translation_name); });
  Object.values(tr.en).forEach(t => add(t.name)); Object.values(tr.tl).forEach(t => add(t.name)); return A; }
const A = { en: allow('en'), tl: checked ? allow('tl') : null }; let bad = 0; const fail = (f, m) => { bad++; console.log(`FAIL ${f}: ${m}`); };
const pages = []; (function walk(d) { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) walk(p); else if (e.name === 'index.html') pages.push(p); } })(dir);
const ALLOWED_SCRIPTS = ['theme-head.js', 'theme.js'].map(n => fs.readFileSync(C(n), 'utf8').trim()); // THE ONE STORAGE ALLOWANCE (owner 2026-10-08, the light/dark switch): these two files' exact bytes may name localStorage; any other mention still fails
for (const f of pages) { const html0 = fs.readFileSync(f, 'utf8'), html = ALLOWED_SCRIPTS.reduce((h, s) => h.split(s).join(''), html0), rel = path.relative(dir, f);
  if (/http-equiv="refresh"/.test(html)) continue; // a short door: one link, no prose
  const lang = (/<html lang="(\w+)"/.exec(html) || [])[1]; if (!lang || !A[lang]) { fail(rel, `lang="${lang}" is not a served language today`); continue; }
  if (/<script[^>]+src=|<img\b|<iframe\b|<link\b[^>]*stylesheet|@import|url\((?![\"']?(?!\/)[\w./-]+\.woff2[\"']?\))|fetch\(|XMLHttpRequest|document\.cookie|localStorage|sessionStorage|gtag|analytics|fbq\(/.test(html)) fail(rel, 'a script src, img, iframe, external request or cookie word'); // THE ONE url( ALLOWED (seat 1007c, the self-hosted Source Serif 4 subsets of DESIGN r5/r6): a RELATIVE woff2 path only — fonts/… or ../fonts/… — no leading / (so //cdn and /abs are refused) and no scheme or host (http(s):// is refused); every other url( still fails
  const body = html.replace(/<script[\s\S]*?<\/script>|<style[\s\S]*?<\/style>|<noscript>[\s\S]*?<\/noscript>|<!--[\s\S]*?-->/g, '');
  const text = body.replace(/<\/?em\b[^>]*>/g, ''); // DESIGN r6: an italic pull-out (<em>) inside one of the owner's lines is unwrapped before the text nodes are read, so the line is read whole, as typed; nothing else is joined (two separate strings around an <em> would read as one and fail)
  for (const m of text.matchAll(/>([^<]+)</g)) { const t = normalise(m[1]); if (t && !A[lang].has(t)) fail(rel, `text not in the allowlist: "${t.slice(0, 80)}"`); }
  const card = /<section id="card"[^>]*>([\s\S]*?)<\/section>/.exec(html); if (!card) fail(rel, 'no <section id="card">');
  else { const inner = card[1].replace(/<[^>]+>/g, '\n'), lines = inner.split('\n').map(s => normalise(s)).filter(Boolean), src = lang === 'tl' ? (cardTl || cardEn) : cardEn;
    if (src) { const want = new Set(blocks(src).flatMap(b => b.split('\n')).map(s => normalise(s)).filter(Boolean)); lines.forEach(l => { if (!want.has(l)) fail(rel, `card block line not in the card file: "${l.slice(0, 60)}"`); }); }
    else if (lines.length !== 1 || lines[0] !== normalise(sheet.placeholder.card) || !/class="placeholder"/.test(card[0])) fail(rel, 'no card file: the card block must be the one greyed placeholder sentence'); }
  const refs = [...html.matchAll(/<li data-day="(\d+)"><(?:p|span) class="ref">([^<]+)</g)].map(m => [+m[1], normalise(m[2])]), pool = verses.map(v => [v.day, normalise(lang === 'tl' ? v.ref_tl : v.ref)]);
  if (JSON.stringify(refs) !== JSON.stringify(pool)) fail(rel, `the forty references differ from content/verses.json (${refs.length} rows)`);
  const h1 = normalise(lang === 'tl' ? J(C('sheet-tl.json')).h1 : sheet.h1), msg = `${h1} ${ADDRESS}`;
  for (const m of html.matchAll(/href="(viber:\/\/forward\?text=|sms:\?&amp;body=|https:\/\/wa\.me\/\?text=|mailto:\?subject=[^&]*&amp;body=)([^"]+)"/g)) if (normalise(decodeURIComponent(m[2])) !== msg) fail(rel, `share text differs: ${decodeURIComponent(m[2]).slice(0, 60)}`);
  for (const m of html.matchAll(/href="fb-messenger:\/\/share\?link=([^"]+)"/g)) if (decodeURIComponent(m[1]) !== ADDRESS) fail(rel, 'messenger link is not the address');
  for (const m of html.matchAll(/href="(https?:\/\/[^"]+)"/g)) if (!/^https:\/\/(www\.knowing-jesus\.com\/|wa\.me\/)/.test(m[1])) fail(rel, `external href ${m[1]}`);
  if (lang === 'en' && checked && !/class="lang"/.test(html)) fail(rel, 'no language link'); if (!checked && /class="lang"/.test(html)) fail(rel, 'a language link under the interim'); }
console.log(`${pages.length} pages checked, ${bad} failures${checked ? '' : ' (the interim: the English pair at the apex; the one placeholder sentence allowed)'}`); process.exit(bad ? 1 : 0);
